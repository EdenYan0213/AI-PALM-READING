# 复制为 .env.local（本地已被 gitignore）或 compose 同目录 .env 使用

# MySQL（compose 内部网络使用固定主机名 mysql）
MYSQL_PASSWORD=root

# LLM（SiliconFlow，OpenAI 兼容）
LLM_ENABLED=true
LLM_API_KEY=
# 可选：显式指定模型与超时
# LLM_MODEL=Pro/moonshotai/Kimi-K2.6
# LLM_VISION_MODEL=
# LLM_FALLBACK_MODEL=ZhipuAI/GLM-5.1
# LLM_CONNECT_TIMEOUT_SECONDS=5
# LLM_READ_TIMEOUT_SECONDS=30

# 用户身份签名密钥（生产必改）
USER_TOKEN_SECRET=palmistry-local-dev-secret

# 运营看板访问令牌（留空则 /metrics/summary 无鉴权）
ADMIN_TOKEN=

# 感知边车（可选，docker compose --profile perception up 后填 http://perception:8100）
PERCEPTION_BASE_URL=

# CORS
CORS_ALLOWED_ORIGINS=http://localhost:8080,http://127.0.0.1:8080
